# Copy this file to .env and replace the placeholder values with local secrets.
DB_URL=jdbc:mysql://localhost:3306/music_database?useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=replace-with-local-database-password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
# Leave REDIS_USERNAME empty for requirepass-only or unauthenticated Redis.
REDIS_USERNAME=
# Leave REDIS_PASSWORD empty when Redis has no password.
REDIS_PASSWORD=replace-with-local-redis-password
REDIS_TIMEOUT=2s

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_FROM=music@example.com
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

JWT_SECRET=replace-with-at-least-32-byte-random-secret
JWT_ISSUER=music-api
JWT_AUDIENCE=music-client
JWT_TTL_SECONDS=86400
