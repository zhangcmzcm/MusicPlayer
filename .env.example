# Copy this file to .env and replace every placeholder value.
# Docker Compose reads .env automatically. Spring Boot does not; export these
# variables in the shell or IDE before running gradlew bootRun.

# MySQL container
MYSQL_DATABASE=music
MYSQL_USERNAME=replace-with-local-database-user
MYSQL_PASSWORD=replace-with-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password

# Spring datasource; keep DB_USERNAME and DB_PASSWORD equal to the MySQL values.
DB_URL=jdbc:mysql://localhost:3306/music?useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=replace-with-local-database-user
DB_PASSWORD=replace-with-local-database-password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
# Leave REDIS_USERNAME empty for requirepass-only or unauthenticated Redis.
REDIS_USERNAME=
# Leave REDIS_PASSWORD empty for the existing local redis-email-code container.
# Set a strong value when starting the Compose-managed Redis service.
REDIS_PASSWORD=
REDIS_TIMEOUT=2s

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_FROM=music@example.com
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

JWT_SECRET=replace-with-at-least-32-byte-random-secret
JWT_ISSUER=music-api
JWT_AUDIENCE=music-client
JWT_TTL_SECONDS=86400

MINIO_ROOT_USER=replace-with-minio-access-key
MINIO_ROOT_PASSWORD=replace-with-minio-secret-key
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_IMAGE=bitnamilegacy/minio@sha256:451fe6858cb770cc9d0e77ba811ce287420f781c7c1b806a386f6896471a349c

# Use the same values as MINIO_ROOT_USER and MINIO_ROOT_PASSWORD.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=replace-with-minio-access-key
S3_SECRET_KEY=replace-with-minio-secret-key
S3_AUDIO_BUCKET=music-audio
S3_COVERS_BUCKET=music-covers
S3_CONNECT_TIMEOUT=2s
S3_READ_TIMEOUT=30s

UPLOAD_MAX_AUDIO_BYTES=209715200
UPLOAD_MAX_COVER_BYTES=20971520

# 播放专用读取连接池上限；不改变上传/封面客户端
S3_STREAM_MAX_CONNECTIONS=50
